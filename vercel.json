{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "shaadi-gpt.vercel.app" }],
      "destination": "https://shaadi24.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.shaadi24.in" }],
      "destination": "https://shaadi24.in/:path*",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "shaadi24.in" }],
      "destination": "https://admin.shaadi24.in/",
      "permanent": true
    },
    {
      "source": "/app-preview",
      "has": [{ "type": "host", "value": "shaadi24.in" }],
      "destination": "https://admin.shaadi24.in/app-preview",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog?view=index"
    },
    {
      "source": "/blog/feed.xml",
      "destination": "/api/blog?view=feed"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?view=post&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/blog?view=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/blog?view=robots"
    },
    {
      "source": "/stories",
      "destination": "/index.html"
    },
    {
      "source": "/b/:link",
      "destination": "/index.html"
    },
    {
      "source": "/family/:link",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/app-preview",
      "destination": "/index.html"
    },
    {
      "source": "/delete-account",
      "destination": "/index.html"
    },
    {
      "source": "/support",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/grievances",
      "destination": "/index.html"
    },
    {
      "source": "/safety",
      "destination": "/index.html"
    },
    {
      "source": "/refunds",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.shaadi24.in" }],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
