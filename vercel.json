{
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog?view=index"
    },
    {
      "source": "/blog/feed.xml",
      "destination": "/api/blog?view=feed"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?view=post&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/blog?view=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/blog?view=robots"
    },
    {
      "source": "/stories",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/app-preview",
      "destination": "/index.html"
    },
    {
      "source": "/delete-account",
      "destination": "/index.html"
    },
    {
      "source": "/support",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/grievances",
      "destination": "/index.html"
    },
    {
      "source": "/safety",
      "destination": "/index.html"
    },
    {
      "source": "/refunds",
      "destination": "/index.html"
    }
  ]
}
