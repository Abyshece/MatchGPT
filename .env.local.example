# ============================================================================
# ShaadiGPT environment variables
#
# Copy this file to .env.local and fill in the values:
#   cp .env.local.example .env.local
# .env.local is git-ignored. Never commit real keys.
# ============================================================================

# ---- Browser app (Vite) ----------------------------------------------------
# Anything starting with VITE_ is bundled into the public website, so only
# put values here that are safe for anyone to see.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → "anon public" key
VITE_SUPABASE_ANON_KEY=

# The website shows the home page and the admin panel; members use the apps.
# true puts the members' app on the website too, for local development and
# the browser tests. Never set it in Vercel.
VITE_MEMBERS_ON_WEB=true

# Where the home page sends people for the apps, once each is live in its
# store (set them in Vercel too). Unset = "Coming soon".
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.matchgpt.app
# VITE_APP_STORE_URL=https://apps.apple.com/app/id…

# Optional. Google sign-in client ID (Google Cloud → Google Auth Platform →
# Clients), for Google's own sign-in button; the site's address must be one of
# the client's "Authorized JavaScript origins". Unset = the built-in default
# in lib/googleSignIn.ts; empty = the classic sign-in.
# VITE_GOOGLE_CLIENT_ID=

# Phone apps (lib/socialSignIn.ts). Google sign-in on Android uses the "Web
# application" client of Supabase's Google provider (built in; this
# overrides it, empty = no Google sign-in on Android):
# VITE_GOOGLE_WEB_CLIENT_ID=
# Google sign-in on iPhones: the "iOS" client for com.matchgpt.app. Unset =
# iPhones don't offer Google. The iOS build adds its URL scheme by itself.
# VITE_GOOGLE_IOS_CLIENT_ID=

# ---- Local scripts only ----------------------------------------------------
# Used by `npx tsx scripts/seed.ts`. Never prefix this with VITE_: it gives
# full access to the database.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Edge function secrets (NOT read from this file) -----------------------
# Set these on the Supabase project instead:
#   npx supabase secrets set NAME=value --project-ref your-project-ref
#
#   ALLOWED_ORIGINS    Comma-separated site origins allowed to call the
#                      functions from a browser, e.g.
#                      https://shaadigpt.com,http://localhost:3000
#                      If unset, any origin is allowed.
#   VAPID_SUBJECT      send-push, e.g. mailto:support@shaadigpt.com
#   GEMINI_API_KEY     search: prompts understood by Google Gemini (free key from
#                      aistudio.google.com); unset = rule-based understanding
#   APPLE_TEAM_ID, APPLE_SIGNIN_KEY_ID, APPLE_SIGNIN_PRIVATE_KEY
#                      Sign in with Apple: the Apple Developer team ID and a key
#                      with "Sign in with Apple" (its ID and the .p8 file's
#                      text), so that deleting an account also ends its Sign in
#                      with Apple (apple-sign-in and delete-account functions)
#
# The Web Push (VAPID) keys are not set by hand: send-push creates them on its
# first run and keeps them in Supabase Vault. The send-push cron job only needs
# the site's Supabase address in Vault, once per project:
#   select vault.create_secret('https://your-project-ref.supabase.co', 'project_url');
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# to edge functions automatically.
